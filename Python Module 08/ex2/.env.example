# Copy this file to .env and fill in real values.
# .env.example IS meant to be committed to version control.
# .env is NOT: it is listed in .gitignore because it can hold real
# secrets (API keys, database passwords) that must never be shared
# or pushed to a public/shared repository.

# "development" or "production"
MATRIX_MODE=development

# Connection string for data storage.
# Example (local):      sqlite:///local_matrix.db
# Example (production):  postgresql://user:password@prod-db.zion.net:5432/matrix
DATABASE_URL=sqlite:///local_matrix.db

# Secret key for external services. Leave empty locally if you don't
# have one; put a real key here only in your untracked .env file.
API_KEY=dummy-development-key-0000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# URL for the resistance network
ZION_ENDPOINT=http://localhost:8080
